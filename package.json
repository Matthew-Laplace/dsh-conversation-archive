{
  "name": "dsh-conversation-archive",
  "version": "0.4.0",
  "description": "在 DeepSeek Harness 里把 Codex CLI 拉成可视化对话窗口：浏览线程、查看最近一轮与全部历史、通过 CLI 继续原线程；CLI 能跑的地方（含 WSL/远程/容器/其他系统）都能用。A Codex CLI-backed conversation panel for DeepSeek Harness.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "codex",
    "codex-cli",
    "codex-gui",
    "chat-ui",
    "conversation-ui",
    "wsl",
    "cross-platform",
    "cli-wrapper",
    "gui"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./adapters/codex/export_codex_threads.py": "./adapters/codex/export_codex_threads.py",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "adapters/**/*.py"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "author": "syc-ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Matthew-Laplace/dsh-conversation-archive.git"
  },
  "homepage": "https://github.com/Matthew-Laplace/dsh-conversation-archive#readme",
  "bugs": {
    "url": "https://github.com/Matthew-Laplace/dsh-conversation-archive/issues"
  }
}
